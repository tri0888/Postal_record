# Chép file này thành `server/.env` rồi điền. `.env` đã nằm trong .gitignore —
# TUYỆT ĐỐI không commit file đã điền: connection string có kèm mật khẩu CSDL.

# Lấy ở MongoDB Atlas -> Cluster -> Connect -> Drivers.
# Nhớ thêm IP máy bạn vào Network Access, nếu không sẽ treo ở bước kết nối.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Tên CSDL trong cluster. Không có sẵn thì Mongo tự tạo lúc ghi lần đầu.
MONGODB_DB=postal_record

# CHỈ điền khi gặp lỗi `querySrv ECONNREFUSED`.
# Chuỗi mongodb+srv:// phải tra bản ghi DNS loại SRV trước khi kết nối; nhiều DNS
# của nhà mạng và mạng cơ quan từ chối loại truy vấn này. Bỏ dấu # ở dòng dưới để
# riêng phần tra SRV đi qua DNS công cộng, khỏi phải sửa cấu hình mạng cả máy.
#MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# Chuỗi ngẫu nhiên dài để ký cookie đăng nhập. BẮT BUỘC — server không khởi động
# nếu thiếu. Sinh một chuỗi mới bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Tài khoản đăng nhập duy nhất của hệ thống.
# Để trống thì mặc định là admin / admin. Đổi mật khẩu = sửa dòng dưới rồi khởi
# động lại server, không phải đụng vào mã nguồn.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

PORT=3000
