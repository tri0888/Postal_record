{
  "name": "postal-record",
  "version": "1.0.0",
  "private": true,
  "description": "Hệ thống Quản lý Hồ sơ Hoàn",
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix frontend",
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --prefix server run dev",
    "dev:web": "npm --prefix frontend run dev",
    "build": "npm run build --prefix frontend",
    "start": "npm start --prefix server",
    "db:init": "node server/scripts/db-init.js",
    "db:reset": "node server/scripts/db-reset.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
